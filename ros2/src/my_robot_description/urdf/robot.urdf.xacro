<?xml version="1.0"?>
<robot name="my_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="wheel_radius" value="0.0425" />  <xacro:property name="wheel_base" value="0.15" />      <xacro:property name="base_width" value="0.25" />      <xacro:property name="base_length" value="0.30" />
    <xacro:property name="base_height" value="0.05" />

    <link name="base_link">
        <visual>
            <geometry>
                <box size="${base_length} ${base_width} ${base_height}" />
            </geometry>
            <origin xyz="0 0 ${base_height/2}" rpy="0 0 0" />
            <material name="blue">
                <color rgba="0.1 0.1 0.8 1.0"/>
            </material>
        </visual>
        <inertial>
            <mass value="5.0" />
            <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02" />
        </inertial>
    </link>

    <link name="left_wheel_link">
        <visual>
            <geometry>
                <cylinder radius="${wheel_radius}" length="0.02" />
            </geometry>
            <origin xyz="0 0 0" rpy="${-M_PI/2} 0 0" />
            <material name="black"/>
        </visual>
    </link>
    <joint name="left_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <origin xyz="0 ${wheel_base/2} ${wheel_radius}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <link name="right_wheel_link">
        </link>
    <joint name="right_wheel_joint" type="continuous">
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <origin xyz="0 ${-wheel_base/2} ${wheel_radius}" rpy="0 0 0" />
        <axis xyz="0 1 0" />
    </joint>

    <xacro:include filename="sensors.urdf.xacro" />
    <xacro:sensor_macro />

    <link name="odom" />
    <joint name="odom_joint" type="fixed">
        <parent link="odom"/>
        <child link="base_link"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

</robot>