<?xml version="1.0"?>
<robot name="my_robot_sensors" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="sensor_macro">

        <xacro:property name="lidar_z_offset" value="0.20" /> <link name="laser_frame">
            <visual>
                <geometry><cylinder radius="0.02" length="0.05"/></geometry>
                <material name="red"/>
            </visual>
        </link>
        <joint name="laser_joint" type="fixed">
            <parent link="base_link"/>
            <child link="laser_frame"/>
            <origin xyz="${base_length/2} 0 ${lidar_z_offset}" rpy="0 0 0"/>
        </joint>


        <link name="imu_link">
            <visual>
                <geometry><box size="0.01 0.01 0.01"/></geometry>
                <material name="green"/>
            </visual>
        </link>
        <joint name="imu_joint" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="0 0 ${base_height + 0.01}" rpy="0 0 0"/> 
        </joint>

    </xacro:macro>

</robot>